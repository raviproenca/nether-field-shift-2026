# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Only needed for datasets behind Earthdata Login (e.g. GLDAS, IMERG); ~/.netrc also works.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Comma-separated allowed CORS origins for the producer dashboard (default: http://localhost:5173)
API_CORS_ORIGINS=

        {
          "name": "T2M_MAX",
          "long_name": "Air temperature at 2 m, daily maximum",
          "unit": "°C"
        },
        {
          "name": "T2M_MIN",
          "long_name": "Air temperature at 2 m, daily minimum",
          "unit": "°C"
        },
        {
          "name": "PRECTOTCORR",
          "long_name": "Precipitation (bias-corrected)",
          "unit": "mm/day"
        },
        {
          "name": "ALLSKY_SFC_SW_DWN",
          "long_name": "All-sky surface shortwave downward irradiance",
          "unit": "MJ/m²/day"
        },
        {
          "name": "RH2M",
          "long_name": "Relative humidity at 2 m",
          "unit": "%"
        },
        {
          "name": "WS2M",
          "long_name": "Wind speed at 2 m",
          "unit": "m/s"
        },
        {
          "name": "GWETTOP",
          "long_name": "Surface soil wetness (0-5 cm)",
          "unit": "1 (fraction, 0-1)"
        },
        {
          "name": "GWETROOT",
          "long_name": "Root zone soil wetness",
          "unit": "1 (fraction, 0-1)"
        }
      ],
      "default_variable": "T2M",
      "max_radius_km": 50,
      "max_period_days": 366,
      "attribution": {
        "dataset": "NASA POWER daily point API (MERRA-2 and CERES SYN1deg), community AG",
        "doi": null,
        "url": "https://power.larc.nasa.gov/",
        "notice": null
      }
    },

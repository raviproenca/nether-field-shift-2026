{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "points.schema.json",
  "title": "Grid points (<region>/points.geojson)",
  "description": "GeoJSON FeatureCollection with one Point feature per grid point that lies on land.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "Feature" },
          "id": { "type": "string", "description": "Point id, the key used in the series files." },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "Point" },
              "coordinates": {
                "type": "array",
                "description": "[longitude, latitude] in degrees (WGS84), as GeoJSON requires.",
                "prefixItems": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "properties": {
            "type": "object",
            "required": ["id", "lat", "lon"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    }
  }
}
